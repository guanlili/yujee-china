# web机（152.136.107.117）环境变量 —— 复制为 env/web.env 后填值，绝不提交真实值。
# 注意：compose.web.yml 的 ${PG_PASSWORD} 等插值也从本文件读取（--env-file 同时供给两用）。

# ── 生产必填七件套（apps/web/src/lib/env.ts assertProductionEnv，缺一启动失败）──
DATABASE_URL=postgres://yujee:待生成PG密码@postgres:5432/yujee
WEB_BASE_URL=http://152.136.107.117
BETTER_AUTH_SECRET=待生成_openssl_rand_base64_32
AGENT_BASE_URL=http://10.8.0.1:8001
AGENT_SHARED_SECRET=待生成_与agent机同值
DESIGN_AGENT_BASE_URL=http://design-agent:8787
DESIGN_AGENT_SHARED_SECRET=待生成_与design-agent同值
PG_PASSWORD=待生成PG密码

# ── AI 生图：国内直连 Ark（env.ts 注释实测北京 5.6s；缺 key 仅生图入口 501）──
IMAGE_PROVIDER=ark
ARK_API_KEY=待填_与agent机同值

# ── 对象存储：腾讯 COS（P2.2 存储 env 化合入后生效，字段名以 PR 为准）──
# S3_ENDPOINT=https://<bucket>.cos.ap-<region>.myqcloud.com
# S3_REGION=ap-<region>
# S3_FORCE_PATH_STYLE=false
# R2_ACCESS_KEY_ID=待填_COS密钥
# R2_SECRET_ACCESS_KEY=待填_COS密钥
# R2_BUCKET=yujee-china
# R2_PUBLIC_BASE_URL=https://<bucket>.cos.ap-<region>.myqcloud.com
# ⚠️ 桶上必须配生命周期规则：analyze-uploads/ 前缀 1 天过期。

# ── cron（Vercel 外不存在默认值；漏配静默 401，部署脚本要自检）──
CRON_SECRET=待生成_openssl_rand_base64_32

# ── 登录：IP 阶段只有邮箱密码 + 游客匿名 ──
# Google/Apple 均不配即自动关闭（Google 两变量缺省关闭；Apple 四件套缺一即禁用）。
# 域名后补时再注册 OAuth 回调。

# ── 支付：IP 阶段不配（P3 微信/支付宝另做）──
