# agent机（82.156.14.48）环境变量 —— 复制为 env/agent.env 后填值，绝不提交真实值。
# 静态运行参数在 compose.agent.yml 的 environment 段，这里只放密钥/环境差异。

# web 机与本机同值（跨服务鉴权：业务端点 + 回调 + 照片档案回传）。
AGENT_SHARED_SECRET=待生成_openssl_rand_base64_32

# 必须与东京 CLIP worker 现值一致（回落链：grouping_clip_secret or agent_shared_secret）。
# 来源：找交接人要 / Fly secrets。轮换必须两边协调。
GROUPING_CLIP_SECRET=待向交接人索取

# 火山 Ark：compose 成稿（P2.1 后）+ photo profile 语义组 + DEEPSEEK 槽共用一把。
ARK_API_KEY=待填_用户火山账号
DEEPSEEK_API_KEY=同_ARK_API_KEY

# ── P2.1 落地前 ────────────────────────────────────────────────
# engine 启动 fail-fast 要求 SELECT_LAYOUT_API_KEY 存在（缺了拒启，防静默交付占位书）。
# 国内部署先填任意非空占位；P2.1（COMPOSE_PROVIDER=ark）合入后此值不再被使用。
SELECT_LAYOUT_API_KEY=占位_P2.1后移除

# ── P2.1 落地后解开 ────────────────────────────────────────────
# COMPOSE_PROVIDER=ark
# COMPOSE_ARK_MODEL=doubao-seed-1-6-vision-250815
