# single.env 模板 —— web / agent / design-agent 三容器共用
# （compose.single.yml 三个服务的 env_file 都指向本文件；clip 容器用 clip.env）。
# 复制为 env/single.env 后填值：chmod 600，绝不提交真实值，服务器落位
# 49.232:~/yujee-clip/deploy/china/env/single.env。
# 静态运行参数（PORT/AGENT_ENABLE_* 等）在 compose.single.yml 的 environment 段，
# 这里只放密钥与随环境变化的值。

# ── 跨服务鉴权（web ↔ agent ↔ design-agent）────────────────────
AGENT_SHARED_SECRET=待生成_openssl_rand_base64_32
DESIGN_AGENT_SHARED_SECRET=待生成_openssl_rand_base64_32

# ── 模型资源：kexiangai 中转站（2026-10-28 起，替代火山直连）──────────────────────────────────────────────────────────────
#   OpenAI 兼容入口；key = 「sk-」+ 控制台 x-api-key（必须带 sk- 前缀，
#   否则 401）。消费方：agent 的 compose 成稿 + photo-profile（ARK_* 槽）、
#   design-agent 对话改书（DESIGN_AGENT_API_KEY）。
#   web 的 AI 生图仍直连火山 seedream，独立 key 见 ARK_IMAGE_API_KEY ——
#   中转站 key 与火山 key 不通用。
ARK_API_KEY=sk-待填_中转站key
# engine 的 ARK_* 槽指向中转站；base URL 以 /v1 结尾（ai_client 拼
# /chat/completions）。
ARK_BASE_URL=https://kexiangai.com/api/v1
# thinking 行为按模型分（2026-10-28 实测）：doubao 系透传 engine 默认的
# thinking:disabled（成稿 4~6s 零思考）；deepseek-v4-pro 无视该参数永远思考。
# 因此保持默认（不发 false），成稿选 doubao 系才有快速档。

# ── agent 容器（engine）：成稿 provider ──────────────────────────
# P2.1 已合入；不设则回落 gemini 线（要 SELECT_LAYOUT_API_KEY，国内不供）。
COMPOSE_PROVIDER=ark
# Seed2.1 原生多模态（已实测中转站真透传图片）；模型名以站内
# https://kexiangai.com/api/v1/models 列表为准（该接口无需鉴权）。
COMPOSE_ARK_MODEL=doubao-seed-2-1-turbo-260628

# ── design-agent 容器：对话改书（openai-compat provider）──────────
#   与 ARK_API_KEY 同值；模型在 compose.single.yml 静态段（kimi-k2.6，
#   实测 1.9s/轮 + 13 工具链冒烟通过；deepseek-v4-pro 为备用，永远思考）。
DESIGN_AGENT_API_KEY=sk-待填_中转站key
#   缺省即 kexiangai，留作显式记录/换站时覆盖。
DESIGN_AGENT_API_BASE_URL=https://kexiangai.com/api/v1

# ── web 容器：生产必填七件套（env.ts assertProductionEnv）─────────
# WEB_BASE_URL 须为正式 HTTPS 入口（无尾斜杠），与 better-auth baseURL 一致；
# buildTrustedOrigins() 会把该 origin 及 https://www.<host> 加入 CSRF 白名单。
# COS 桶 CORS Origin 须同步包含 https://outman.press（及 www 若对外使用）。
DATABASE_URL=postgres://yujee:待生成PG密码@postgres:5432/yujee
PG_PASSWORD=待生成PG密码
WEB_BASE_URL=https://outman.press
BETTER_AUTH_SECRET=待生成_openssl_rand_base64_32
AGENT_BASE_URL=http://agent:8001
DESIGN_AGENT_BASE_URL=http://design-agent:8787

# ── web 容器：AI 生图（火山 seedream 直连；2026-10-28 决策暂不迁中转）──
#   中转站的 kexiang provider（SeeDream4.5 异步任务 API，按张 0.2 元、扣
#   积分）代码已合入备用：想切时改 IMAGE_PROVIDER=kexiang 并确保积分余额，
#   届时火山 key 可退役。
IMAGE_PROVIDER=ark
ARK_IMAGE_API_KEY=待填_火山方舟key

# ── web 容器：对象存储 = 腾讯 COS（凭证复用 R2_* 三件套名）───────
# app 走的是 R2_* + S3_ENDPOINT 这一族；桶须先配 CORS（Origin=入口）与
# analyze-uploads/ 前缀 1 天过期的生命周期规则。
S3_ENDPOINT=https://<bucket>-<appid>.cos.ap-<region>.myqcloud.com
S3_REGION=ap-<region>
S3_FORCE_PATH_STYLE=false
R2_ACCESS_KEY_ID=待填_COS密钥
R2_SECRET_ACCESS_KEY=待填_COS密钥
R2_BUCKET=<bucket>-<appid>
R2_PUBLIC_BASE_URL=https://<bucket>-<appid>.cos.ap-<region>.myqcloud.com

# ── web 容器：cron（Vercel 外无默认值；漏配静默 401）─────────────
CRON_SECRET=待生成_openssl_rand_base64_32

# ── web 容器：admin（可选）───────────────────────────────────────
ADMIN_EMAILS=you@example.com

# ── 登录：IP 阶段只有邮箱密码 + 手机号 + 游客匿名 ────────────────
# Google 登录已移除（代码不再挂载 provider，GOOGLE_* 留空即可）；
# Apple 四件套不配即自动关闭；域名后补时再注册 OAuth 回调。
# 邮件默认 capture 模式：验证链接写 web 容器
# /app/apps/web/.tmp/email-capture.jsonl，注册须从中捞链接（或直改库）。

# ── 短信 OTP（阿里云国内短信，2026-10-28 起）────────────────────
# SMS_DELIVERY=capture 时验证码同样写 email-capture.jsonl（kind
# phone-otp / phone-otp-reset），零密钥可跑；切 aliyun 前四件套必须配齐
# （env.ts assertProductionEnv 启动即校验，漏配 web 容器起不来）。
# AK 用 RAM 子账号（只授 dysms:SendSms），绝不复用主账号 key。
# 模板：登录/注册与找回共用一个验证码模板（变量 ${code}，5 分钟有效）。
SMS_DELIVERY=aliyun
ALIYUN_SMS_ACCESS_KEY_ID=待填_RAM子账号AK
ALIYUN_SMS_ACCESS_KEY_SECRET=待填_RAM子账号SK
ALIYUN_SMS_SIGN_NAME=待填_阿里云已审核签名
# 形态示例（现用模板，登录与找回共用）；换环境以控制台审核通过的 CODE 为准
ALIYUN_SMS_TEMPLATE_CODE=SMS_512527217
