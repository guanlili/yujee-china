NEXT_PUBLIC_APP_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:3000

# 生成 Agent (engine/, FastAPI, :8001) —— 分章 / 选版 / 成稿
AGENT_BASE_URL=http://localhost:8001
AGENT_SHARED_SECRET=dev_secret_replace_me

# 设计 Agent (packages/design-agent, Node, :8787) —— 生成之后的对话式改书。
# 起了 web 和 agent 却漏起这个服务 => /api/v3/albums/[uuid]/design-chat 直接 502。
# 本地留空则不带鉴权头;生产两边必须一致。
DESIGN_AGENT_BASE_URL=http://localhost:8787
DESIGN_AGENT_SHARED_SECRET=

# 上面这些在开发环境有兜底默认值,零配置也能起。但**真生产**
# (VERCEL_ENV=production,或自托管的 NODE_ENV=production)下,以下变量必须显式设置,
# 缺任何一个都会启动失败,而不是带着占位值静默连错库/错服务:
#   DATABASE_URL · WEB_BASE_URL · BETTER_AUTH_SECRET
#   AGENT_BASE_URL · AGENT_SHARED_SECRET
#   DESIGN_AGENT_BASE_URL · DESIGN_AGENT_SHARED_SECRET
# 见 apps/web/src/lib/env.ts 的 assertProductionEnv。

DATABASE_URL=
BETTER_AUTH_SECRET=

# Auth · Google OAuth —— 国内版已移除 Google 登录,这两个变量不再被读取
# (字段在 env.ts 保留一迭代仅为兼容存量环境;生产应清空 GOOGLE_*)。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth · Sign in with Apple(四个必须齐全才启用;APPLE_CLIENT_ID 是 Services ID)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Payment · Creem(海外主通道。Stripe 已下线,不要再加 STRIPE_* —— 有测试断言它不存在)
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_ID_PACK_1=
CREEM_PRODUCT_ID_PACK_4=
CREEM_PRODUCT_ID_PACK_10=

# Payment · Waffo Pancake(海外主通道,替换 Creem;私钥 PEM 转义换行或 base64 均可,SDK 自归一)
# 生产必须 WAFFO_ENV=prod。webhook 公钥 SDK 内置,无需配置。
WAFFO_MERCHANT_ID=
# WAFFO_STORE_ID 不是可选项——webhook 靠它绑定"这是我们店的事件"(租户边界安全控制)。
# waffo-service 的 store 门是 fail-closed:漏配会拒收全部 webhook,不发积分。必须与
# WAFFO_MERCHANT_ID 同批配置。生产漏配会被 assertProductionEnv 当场拦下。
WAFFO_STORE_ID=
WAFFO_PRIVATE_KEY=
WAFFO_ENV=test
WAFFO_PRODUCT_ID_PACK_1=
WAFFO_PRODUCT_ID_PACK_4=
WAFFO_PRODUCT_ID_PACK_10=

# Storage · Cloudflare R2(PDF / 封面缩略图,presigned PUT)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
