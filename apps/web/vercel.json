{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "github": {
    "silent": true
  },
  "installCommand": "pnpm install",
  "buildCommand": "pnpm db:migrate && pnpm build",
  "crons": [
    {
      "path": "/api/v1/admin/recover-stuck",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/v1/admin/cleanup-photos",
      "schedule": "0 3 * * *"
    }
  ]
}
