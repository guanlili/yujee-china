    "@aws-sdk/s3-request-presigner": "^3.1155.0",
    "@waffo/pancake-ts": "0.26.0",
    "@yujee/contracts": "workspace:*",
    "better-auth": "1.7.12",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "heic-to": "^1.6.6",
    "html2canvas-pro": "^2.5.2",
    "jspdf": "^4.2.1",
    "marked": "^18.1.1",
    "mp4-muxer": "^5.2.2",
    "next": "15.5.28",
    "next-intl": "4.14.9",
    "postgres": "^3.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "subset-font": "^2.9.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
