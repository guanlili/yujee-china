{
  "name": "@yujee/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:repos": "tsx --test src/db/repos/*.test.ts src/services/job/zombie-sweeper.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sitemap:check": "tsx scripts/sitemap-freshness-check.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "test:admin": "ADMIN_TEST_EXCLUSIVE=1 tsx --test src/services/admin/admin-service.test.ts"
  },
  "dependencies": {
    "@alicloud/dysmsapi20170525": "4.6.0",
    "@alicloud/openapi-client": "0.4.15",
